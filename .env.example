# Copy to .env and adjust. Used by `docker compose` (and readable by your process manager for native runs).

# ---- Mode ----
# memory:      everything in one process, no Redis/RabbitMQ needed (default)
# distributed: RabbitMQ distributes virtual users to worker machines, Redis holds shared state
LT_MODE=memory

# ---- Web app ----
HOST=127.0.0.1                 # 0.0.0.0 to expose on the network (enable auth!)
PORT=4100
LT_DATA_DIR=.data              # SQLite database with tests, users files and results
LT_AUTH_USER=admin             # HTTP basic auth for the UI/API (disabled when empty)
LT_AUTH_PASSWORD=change-me
LT_API_TOKEN=                  # bearer token for CI (`lt ci --token ...`)
LT_EMBEDDED_WORKER=true        # distributed mode: also run a worker inside the app process (always on in memory mode)
LT_EMBEDDED_WORKER_CONCURRENCY=  # default 1000 in memory mode, 100 in distributed mode
LT_RECORDER_ENABLED=true       # live browser recording (needs a desktop session)
LT_RECORDER_HEADLESS=false
LT_REDIS_RUN_TTL_SEC=86400     # keep raw run data in Redis this long after results are saved
LT_MAX_UPLOAD_MB=50
LOG_LEVEL=info

# ---- Infrastructure (distributed mode only) ----
AMQP_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379
LT_JOB_QUEUE=lt.vu.jobs

# ---- Workers ----
LT_CONCURRENCY=200             # max virtual users per worker

# ---- docker compose host ports ----
APP_PORT=4100
AMQP_PORT=5672
RABBITMQ_UI_PORT=15672         # on Windows try 25672 if 15672 is reserved
REDIS_PORT=6379
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
